(( $+functions[_vw_commands] )) ||
_vw_commands() {
    local commands; commands=(
'init:Initialize repository-local vde-worktree state' \
'list:List worktrees and status metadata' \
'status:Show a single worktree status' \
'path:Print the absolute path for a branch worktree' \
'switch:Reuse or create a worktree for a branch' \
'new:Create a branch and its worktree' \
'mv:Rename the current linked worktree branch' \
'del:Delete a linked worktree and branch' \
'gone:Find or delete stale merged worktrees' \
'adopt:Find or move unmanaged worktrees into the managed root' \
'get:Fetch and attach a remote branch' \
'extract:Extract the current primary branch into the managed root' \
'absorb:Transfer linked worktree changes into the primary worktree' \
'unabsorb:Transfer primary worktree changes into a linked worktree' \
'use:Check out a branch in the primary worktree' \
'exec:Run an argv command in a branch worktree' \
'invoke:Invoke a named hook' \
'copy:Copy repository-relative paths into the target worktree' \
'link:Link repository-relative paths into the target worktree' \
'lock:Protect a worktree with persistent lock metadata' \
'unlock:Remove persistent lock metadata' \
'cd:Select a worktree path interactively' \
'completion:Generate or install shell completions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'vw commands' commands "$@"
}
